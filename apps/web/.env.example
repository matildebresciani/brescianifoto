# Database connection string
DATABASE_URI=mongodb://127.0.0.1:27017/?directConnection=true&serverSelectionTimeoutMS=2000

# Or use a PG connection string
#DATABASE_URI=postgresql://127.0.0.1:5432/your-database-name

# Used to encrypt JWT tokens
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Used to configure CORS, format links and more. No trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Secret used to authenticate cron jobs
CRON_SECRET=YOUR_CRON_SECRET_HERE

# API key for MedusaJS integration
MEDUSA_API_KEY=MEDUSA_API_KEY

# Medusa Backend URL
MEDUSA_BACKEND_URL=https://b2b-demo.medusajs.app

# Cloudflare R2: required in production. Leave unset for local file storage.
# R2_BUCKET=brescianifoto-media
# R2_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY_ID
# R2_SECRET_ACCESS_KEY=YOUR_R2_SECRET_ACCESS_KEY
# Copy the S3 API endpoint without a bucket path; EU jurisdiction uses .eu.r2.cloudflarestorage.com.
# R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
# No trailing slash. Use the public r2.dev URL for testing and a custom domain before launch.
# R2_PUBLIC_URL=https://media.yourdomain.com
# Direct uploads require bucket CORS allowing PUT from NEXT_PUBLIC_SERVER_URL,
# with Content-Type and If-None-Match headers (or AllowedHeaders: ["*"]).

# For resetting forgotten passwords
RESEND_API_KEY=YOUR_RESEND_API_KEY
