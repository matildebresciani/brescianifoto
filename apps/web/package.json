{
    "name": "web",
    "version": "1.0.0",
    "description": "Website template for Payload",
    "license": "MIT",
    "type": "module",
    "scripts": {
        "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
        "cycle-import-check": "cycle-import-scan ./src",
        "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
        "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
        "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types && next typegen",
        "format:check": "biome format",
        "format:fix": "biome format --fix",
        "lint": "cross-env NODE_OPTIONS=--no-deprecation biome check .",
        "lint:fix": "cross-env NODE_OPTIONS=--no-deprecation biome check . --fix",
        "migrate:fresh": "pnpm run payload migrate:fresh",
        "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
        "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
        "test:unit": "vitest --project=unit",
        "typecheck": "tsc --noEmit",
        "storybook": "storybook dev -p 6006",
        "build-storybook": "storybook build",
        "seed": "pnpm run payload seed"
    },
    "dependencies": {
        "@lexical/react": "^0.24.0",
        "@next/third-parties": "^15.5.4",
        "@payloadcms/db-mongodb": "3.79.0",
        "@payloadcms/db-postgres": "3.79.0",
        "@payloadcms/email-resend": "3.79.0",
        "@payloadcms/live-preview-react": "3.79.0",
        "@payloadcms/next": "3.79.0",
        "@payloadcms/payload-cloud": "3.79.0",
        "@payloadcms/plugin-form-builder": "3.79.0",
        "@payloadcms/plugin-nested-docs": "3.79.0",
        "@payloadcms/plugin-redirects": "3.79.0",
        "@payloadcms/plugin-search": "3.79.0",
        "@payloadcms/plugin-seo": "3.79.0",
        "@payloadcms/richtext-lexical": "3.79.0",
        "@payloadcms/storage-vercel-blob": "3.79.0",
        "@payloadcms/translations": "3.79.0",
        "@payloadcms/ui": "3.79.0",
        "@radix-ui/react-checkbox": "^1.3.3",
        "@radix-ui/react-label": "^2.1.7",
        "@radix-ui/react-select": "^2.2.6",
        "@radix-ui/react-slot": "^1.2.4",
        "@tanstack/react-query": "^5.90.2",
        "@types/luxon": "^3.7.1",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "cross-env": "^7.0.3",
        "cycle-import-check": "^1.4.0",
        "graphql": "^16.11.0",
        "html-react-parser": "^5.2.17",
        "lexical": "^0.24.0",
        "lucide-react": "^0.545.0",
        "luxon": "^3.7.2",
        "motion": "^12.23.22",
        "next": "^16.1.6",
        "next-intl": "^4.8.3",
        "next-sitemap": "^4.2.3",
        "payload": "3.79.0",
        "payload-admin-bar": "^1.0.7",
        "prism-react-renderer": "^2.4.1",
        "react": "^19.2.4",
        "react-dom": "^19.2.4",
        "react-hook-form": "7.64.0",
        "sharp": "0.32.6",
        "slugify": "^1.6.6",
        "string-ts": "^2.3.1",
        "swiper": "^12.1.2",
        "tailwind-merge": "^2.6.0",
        "tailwindcss-animate": "^1.0.7",
        "ts-toolbelt": "^9.6.0",
        "vitest": "^4.0.18",
        "zod": "^4.3.6",
        "zustand": "^5.0.11"
    },
    "devDependencies": {
        "@chromatic-com/storybook": "^5.0.1",
        "@biomejs/biome": "2.4.4",
        "@repo/typescript-config": "workspace:*",
        "@storybook/addon-a11y": "^10.2.17",
        "@storybook/addon-docs": "^10.2.17",
        "@storybook/addon-onboarding": "^10.2.17",
        "@storybook/addon-vitest": "^10.2.17",
        "@storybook/nextjs": "^10.2.17",
        "@tailwindcss/postcss": "4.1.14",
        "@tailwindcss/typography": "^0.5.19",
        "@types/escape-html": "^1.0.4",
        "@types/node": "22.5.4",
        "@types/react": "19.0.7",
        "@types/react-dom": "19.0.3",
        "@vitest/browser-playwright": "4.0.18",
        "@vitest/coverage-v8": "4.0.18",
        "copyfiles": "^2.4.1",
        "playwright": "^1.58.2",
        "postcss": "^8.5.6",
        "storybook": "^10.2.17",
        "tailwindcss": "4.1.14",
        "typescript": "5.7.3",
        "vite": "^8.0.0"
    },
    "engines": {
        "node": "^18.20.2 || >=20.9.0"
    }
}
